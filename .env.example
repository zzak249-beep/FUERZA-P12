# ===== Telegram (obligatorio) =====
# 1) En Telegram habla con @BotFather -> /newbot -> copia el token aquí
# 2) Escribe /start a tu bot y ejecuta:  python bot.py --get-chat-id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Qué escanear =====
TIMEFRAMES=15m,5m
QUOTE_ASSETS=USDT
# Con dinero real conviene exigir liquidez: 5000000 (5 M USDT en 24 h) o más
MIN_VOLUME_24H_USDT=5000000
INCLUDE_REGEX=
EXCLUDE_REGEX=

# ===== Tu capital y riesgo =====
# ACCOUNT_USDT = capital que le asignas al bot (si tu saldo real es menor, manda el saldo real)
ACCOUNT_USDT=1000
RISK_PCT=1.0
MAX_LEV=3

# ===== Señales =====
# Deja solo los tipos con ventaja demostrada en el backtest
SIGNAL_TYPES=G1,G3,G4,G5,G7,G8
DIRECTION=both
HTF_MAP=5m:1h,15m:4h

# ===== Gestión de la operación (igual que tu estrategia de TradingView) =====
PARTIAL_PCT=50
TRAIL_MULT=1.0
USE_TIME_STOP=1
MAX_BARS=40
EXIT_ON_OPP=1

# ===== Seguimiento virtual y avisos =====
TRACK_TRADES=1
# Tope de operaciones VIRTUALES abiertas (0 = sin tope; con ejecución real usa 0 y limita con MAX_LIVE_TRADES)
MAX_OPEN_TRADES=0
TELEGRAM_COMMANDS=1
SUMMARY_HOUR_UTC=8
SCAN_ON_START=0
MAX_SIGNALS_PER_SCAN=15

# ===== Railway: con un Volume montado en /data se conservan estado y operaciones =====
# STATE_FILE=/data/state.json
# TRADES_FILE=/data/trades.json
# (las operaciones reales se guardan junto a STATE_FILE en live_trades.json)

# =====================================================================
# EJECUCIÓN EN BINGX  (v3)
# =====================================================================
# 0 = solo señales (no usa claves). 1 = el bot abre las operaciones en BingX.
LIVE_TRADING=0
# demo = dinero virtual VST (open-api-vst.bingx.com)  |  live = DINERO REAL
BINGX_ENV=demo
# Crea la clave en BingX -> Gestión de API: permisos de LECTURA y de TRADING de futuros. SIN retiros.
# Usa claves distintas para demo y real. Ideal: una SUBCUENTA solo para el bot.
BINGX_API_KEY=
BINGX_API_SECRET=
# auto = lo detecta de tu cuenta | hedge (long y short separados) | oneway
POSITION_MODE=auto
# Apalancamiento (margen aislado). Nunca por debajo de ceil(MAX_LEV).
LIVE_LEVERAGE=3
# Máximo de operaciones reales abiertas a la vez (una por símbolo)
MAX_LIVE_TRADES=3
# No entra si el precio ya se movió más de esta fracción de R desde el cierre de la vela de la señal
MAX_ENTRY_DRIFT_R=0.25
# Si el día (UTC) suma -N R o peor, no abre más hasta mañana. 0 = sin límite
DAILY_LOSS_LIMIT_R=3
# Precio que dispara SL/TP: MARK_PRICE (recomendado) | CONTRACT_PRICE | INDEX_PRICE
TRIGGER_PRICE=MARK_PRICE
# Cada cuántos segundos vigila órdenes y posiciones
LIVE_POLL_SEC=10
# LIVE_TRADES_FILE=/data/live_trades.json

# ===== Ajuste fino (por defecto = indicador de TradingView) =====
# REGIME_MODE=ER        # ER | ADX | ER+ADX
# ER_MIN=0.25
# USE_DELTA=1
# USE_PREV_DAY=0
# COST_MULT=5
# RATE_LIMIT_RPS=8
# WORKERS=8
