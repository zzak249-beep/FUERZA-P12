# ---------- CREDENCIALES ----------
BINGX_API_KEY=
BINGX_API_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- MODO ----------
# true = solo avisa por Telegram, NO opera (EMPIEZA SIEMPRE ASÍ)
DRY_RUN=true
# true = cuenta demo VST de BingX
BINGX_DEMO=false
# hedge (por defecto en BingX) | oneway
POSITION_MODE=hedge

# ---------- MERCADO ----------
# ALL = todo, TOP:30 = los 30 más líquidos; o una lista. ALL = analiza todo BingX filtrado por liquidez; o una lista: BTC/USDT:USDT,ETH/USDT:USDT
SYMBOLS=ALL
# crypto,stock (opcional: index,fx,commodity)
ASSET_CLASSES=crypto,stock
MIN_VOL_USDT=3000000
MAX_SYMBOLS=120
MAX_SPREAD_PCT=0.06
EXCLUDE=
# acciones: solo sesión regular NYSE (pon false si operas acciones tokenizadas 24/7)
STOCK_RTH_ONLY=true
# 0=Base 1=V2(filtros) 2=V3(+momentum) 3=V4(+HaP)
BOOK=1
MAX_POSITIONS=3

# ---------- RIESGO ----------
RISK_PCT=1.0
MAX_LEV=10
LEVERAGE=10
PARTIAL_MODE=true
TP_SINGLE_R=1.5
ALLOW_LONG=true
ALLOW_SHORT=true

# ---------- PERSISTENCIA (volumen Railway montado en /data) ----------
DATA_DIR=/data

# ---------- TIMEFRAME ----------
# 15m o 1h (los TF superiores se derivan solos). Compara con backtest.py --compare
TF=15m

# ---------- MEJORAS (todas desactivables) ----------
META_ON=true
META_STRICT=false
META_SIZING=false
SEASON_ON=true
FUNDING_ON=false
TRAIL_ON=false
TRAIL_ATR=2.0
VOL_SCALE_ON=false

# ---------- SEGURIDAD ----------
RATE_LIMIT_MS=250
DAILY_LOSS_PCT=3.0

# ---------- AVISOS (formato de tu escáner) ----------
ACCOUNT_USDT=1000            # solo para el tamaño sugerido en modo señales
MAX_OPEN_TRADES=8            # tope de operaciones virtuales abiertas (DRY_RUN)
MAX_SIGNALS_PER_SCAN=15
TELEGRAM_COMMANDS=true       # /stats /semana /abiertas /estado
SUMMARY_HOUR_UTC=8           # -1 = sin resumen diario

# ---------- FILTROS TOMADOS DE TU ESCÁNER (apagados: mídelos con backtest) ----------
USE_ER=false
ER_MIN=0.25
USE_BODY=false
BODY_MIN=0.55
USE_CLIMAX=false
CLIMAX_MULT=1.8
COST_MULT=0

# ---------- CONCENTRACIÓN / TIPO DE TP ----------
MAX_SAME_DIR=2        # máx. posiciones abiertas en la misma dirección
TP_ORDER=trigger      # trigger (visible en TP/SL) | limit (comisión maker; puede no ejecutarse)
